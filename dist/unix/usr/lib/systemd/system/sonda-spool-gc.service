# Garbage collect the spool, independently of measurements and ETL.
#
# Settings (e.g., `max-age`) come from `/etc/sonda/config.toml`, so we
# pass no flags here: command line flags would override the config.

[Unit]
Description=Garbage collect the sonda spool

[Service]
Slice=system-sonda.slice
Type=oneshot
ExecStart=/usr/bin/sonda spool gc
User=_sonda
Group=_sonda

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/spool/sonda
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes
