# See docs/design/2026-10-04-01-config-file.md for the flags policy.

[Unit]
Description=Garbage collect the sonda spool

[Service]
Slice=system-sonda.slice
Type=oneshot
User=_sonda
Group=_sonda
ExecStart=/usr/libexec/sonda/sonda-spool-gc --spool-dir=/var/spool/sonda

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/spool/sonda
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes
