[Unit]
Description=Run sonda scan
After=network-online.target sonda-inetd-ptnop.socket
Wants=network-online.target
Requires=sonda-inetd-ptnop.socket

[Service]
Slice=system-sonda.slice
Type=oneshot
ExecStart=/usr/bin/sonda scan --workflow-file /etc/sonda/scan/default.yml
User=_sonda
Group=_sonda

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/spool/sonda /var/lib/sonda/metrics
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes
