# See docs/design/2026-10-04-01-config-file.md for the flags policy.

[Unit]
Description=Run sonda scan
After=network-online.target sonda-inetd-ptnop.service
Wants=network-online.target
Requires=sonda-inetd-ptnop.service

[Service]
Slice=system-sonda.slice
Type=oneshot
Environment=SONDA_ETC_PATH=/etc/sonda
ExecStart=/usr/libexec/sonda/sonda-scan \
	--ptnop-socket=/run/sonda/inetd-ptnop/sock \
	--run-dir=/run/sonda \
	--workflow-file=/etc/sonda/scan/default.yml

# Must have access to the whole of `/run/sonda` otherwise it cannot
# perform hard linking for ETL services.
ReadWritePaths=/run/sonda

User=_sonda
Group=_sonda

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes
