# See docs/design/2026-10-04-01-config-file.md for the flags policy.

[Unit]
Description=Run sonda scan
After=network-online.target sonda-serve-ptnop.service
Wants=network-online.target
Requires=sonda-serve-ptnop.service

[Service]
Slice=system-sonda.slice
Type=oneshot
Environment=SONDA_ETC_PATH=/etc/sonda
ExecStart=/usr/libexec/sonda/sonda-scan \
	--ptnop-socket=/run/sonda/serve-ptnop/sock \
	--run-dir=/run/sonda \
	--scheduler-state=/var/lib/sonda/scan/sched.json \
	--workflow-file=/etc/sonda/scan/dns_https.yml \
	--workflow-file=/etc/sonda/scan/dns_udp.yml \
	--workflow-file=/etc/sonda/scan/https_lite.yml \
	--workflow-file=/etc/sonda/scan/https_page.yml

# Important: *must* have access to the whole of `/run/sonda` otherwise it
# cannot perform triggers hard linking for ETL services.
ReadWritePaths=/run/sonda /var/lib/sonda/scan

User=_sonda
Group=_sonda

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes
