# See docs/design/2026-10-04-01-config-file.md for the flags policy.

[Unit]
Description=Serve sonda ptnop measurement requests

[Service]
Slice=system-sonda.slice
User=_sonda
Group=_sonda
Environment=SONDA_ETC_PATH=/etc/sonda
UMask=0007
Restart=on-failure
ExecStartPre=rm -f /run/sonda/inetd-ptnop/sock
ExecStart=/usr/libexec/sonda/sonda-inetd-ptnop \
	--socket=/run/sonda/inetd-ptnop/sock \
	--spool-dir=/var/spool/sonda

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/sonda/inetd-ptnop /var/spool/sonda/ptnop
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
