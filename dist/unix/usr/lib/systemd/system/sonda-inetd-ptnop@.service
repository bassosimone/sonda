# See docs/design/2026-10-04-01-config-file.md for the flags policy.

[Unit]
Description=Serve sonda ptnop measurement requests (connection %i)

[Service]
Slice=system-sonda.slice
StandardInput=socket
StandardError=journal
User=_sonda
Group=_sonda
ExecStart=/usr/libexec/sonda/sonda-inetd-ptnop --spool-dir=/var/spool/sonda

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/spool/sonda/ptnop
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes
