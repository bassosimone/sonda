[Unit]
Description=Archive sonda ptnop events

[Service]
Slice=system-sonda.slice
Type=oneshot
ExecStart=/usr/libexec/sonda/sonda-etl-ptnop-archive
User=_sonda
Group=_sonda

# Keep the ETL from competing with the measurements for CPU and I/O.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/sonda/etl-ptnop-archive /var/lib/sonda/archive/ptnop
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes
