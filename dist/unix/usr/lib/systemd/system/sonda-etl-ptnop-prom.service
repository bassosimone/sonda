# See docs/design/2026-10-04-01-config-file.md for the flags policy.

[Unit]
Description=Publish sonda Prometheus metrics

[Service]
Slice=system-sonda.slice
Type=exec
Restart=on-failure
User=_sonda
Group=_sonda
Environment=SONDA_ETC_PATH=/etc/sonda
ExecStart=/usr/libexec/sonda/sonda-etl-ptnop-prom \
	--http=127.0.0.1:9774 \
	--run-dir=/run/sonda \
	--slice-dir=/sys/fs/cgroup/system.slice/system-sonda.slice \
	--spool-dir=/var/spool/sonda

# Keep the ETL from competing with the measurements for CPU and I/O.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/sonda/etl-ptnop-prom
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
