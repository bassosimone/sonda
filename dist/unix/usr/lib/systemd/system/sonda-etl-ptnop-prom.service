[Unit]
Description=Publish sonda Prometheus metrics

[Service]
Slice=system-sonda.slice
Type=exec
ExecStart=/usr/libexec/sonda/sonda-etl-ptnop-prom
Restart=on-failure
User=_sonda
Group=_sonda

# Keep the ETL from competing with the measurements for CPU and I/O.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/sonda/etl-ptnop-prom
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
