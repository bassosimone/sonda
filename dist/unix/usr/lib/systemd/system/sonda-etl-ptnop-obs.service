[Unit]
Description=Extract sonda observations

[Service]
Slice=system-sonda.slice
Type=oneshot
ExecStart=/usr/libexec/sonda/sonda-etl-ptnop-obs
User=_sonda
Group=_sonda

# Keep the ETL from competing with the measurements for CPU and I/O.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/sonda/etl-ptnop-obs /var/lib/sonda/metrics
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
RestrictRealtime=yes
