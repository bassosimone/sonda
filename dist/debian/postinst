#!/bin/sh
set -e

# The systemd handling below adapts the maintainer-script snippets
# from `/usr/share/debhelper/autoscripts/` in `debhelper==13.31ubuntu1`.

case "$1" in
    configure)
        # Create the _sonda system user and group if they don't exist.
        if ! getent passwd _sonda >/dev/null 2>&1; then
            adduser --system --group --home /nonexistent \
                --no-create-home --quiet _sonda
        fi

        # Ensure the spool directory exists with correct ownership.
        install -d -o _sonda -g adm -m 2750 /var/spool/sonda

        # Ensure the metrics directory exists with correct ownership.
        install -d -o _sonda -g adm -m 2750 /var/lib/sonda/metrics
        ;;
esac

# Enable the timer on first installation only and otherwise rely on
# what has been configured by the sysadmin.
#
# Adapted from autoscripts/postinst-systemd-enable, dropping the
# transitional unmask line to be removed after trixie+1.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
    # was-enabled defaults to true, so new installations run enable.
    if deb-systemd-helper --quiet was-enabled 'sonda-scan.timer'; then
        # Enables the unit on first installation, creates new
        # symlinks on upgrades if the unit file has changed.
        deb-systemd-helper enable 'sonda-scan.timer' >/dev/null || true
    else
        # Update the statefile to add new symlinks (if any), which need to be
        # cleaned up on purge. Also remove old symlinks.
        deb-systemd-helper update-state 'sonda-scan.timer' >/dev/null || true
    fi
fi

# Reload systemd and start the timer, but only when systemd is
# running (not in a chroot) and respecting policy-rc.d.
#
# Adapted from autoscripts/postinst-systemd-start.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
    if [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        deb-systemd-invoke start 'sonda-scan.timer' >/dev/null || true
    fi
fi
