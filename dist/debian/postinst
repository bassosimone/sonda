#!/bin/sh
set -e

# The systemd handling below adapts the maintainer-script snippets
# from `/usr/share/debhelper/autoscripts/` in `debhelper==13.31ubuntu1`.

case "$1" in
    configure)
        # Create the _sonda system user and group if they don't exist.
        if ! getent passwd _sonda >/dev/null 2>&1; then
            adduser --system --group --home /nonexistent \
                --no-create-home --quiet _sonda
        fi

        # Ensure the spool directory exists with correct ownership.
        install -d -o _sonda -g _sonda -m 2750 /var/spool/sonda

        # Ensure the metrics directory exists with correct ownership.
        install -d -o _sonda -g _sonda -m 2750 /var/lib/sonda/metrics

        # Ensure the run directory exists with correct ownership.
        if [ -x "$(command -v systemd-tmpfiles)" ]; then
            systemd-tmpfiles ${DPKG_ROOT:+--root="$DPKG_ROOT"} --create sonda.conf || true
        fi
        ;;
esac

# Enable the socket and the timers on first installation only and
# otherwise rely on what has been configured by the sysadmin.
#
# Adapted from autoscripts/postinst-systemd-enable, dropping the
# transitional unmask line to be removed after trixie+1.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
    for unit in 'sonda-inetd-ptnop.socket' 'sonda-etl-ptnop-qoe.timer' 'sonda-etl-ptnop-obs.path' 'sonda-scan.timer' 'sonda-spool-gc.timer'; do
        # was-enabled defaults to true, so new installations run enable.
        if deb-systemd-helper --quiet was-enabled "$unit"; then
            # Enables the unit on first installation, creates new
            # symlinks on upgrades if the unit file has changed.
            deb-systemd-helper enable "$unit" >/dev/null || true
        else
            # Update the statefile to add new symlinks (if any), which need to be
            # cleaned up on purge. Also remove old symlinks.
            deb-systemd-helper update-state "$unit" >/dev/null || true
        fi
    done
fi

# Reload systemd and start the socket and the timers, but only when systemd is
# running (not in a chroot) and respecting policy-rc.d.
#
# Adapted from autoscripts/postinst-systemd-start.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
    if [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        deb-systemd-invoke start 'sonda-inetd-ptnop.socket' 'sonda-etl-ptnop-qoe.timer' 'sonda-etl-ptnop-obs.path' 'sonda-scan.timer' 'sonda-spool-gc.timer' >/dev/null || true
    fi
fi
